+                        </>
+                    )}
+                </Callout>
+            )}
+
+            <Cli>{cliCommand(change)}</Cli>
+            <Note style={{ marginTop: 10 }}>
+                The tab runs the same simulation as the CLI, over data rebuilt on each request. The CLI is
+                authoritative.
+            </Note>
+        </Wrapper>
+    );
+}
