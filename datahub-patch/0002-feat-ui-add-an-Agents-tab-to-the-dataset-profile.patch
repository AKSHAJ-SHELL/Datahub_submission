+/**
+ * The shape of `GET /agentlens/payload.json`, served by `agentlens serve`.
+ *
+ * Field names are snake_case where they come straight out of the Python model
+ * (`source_path`, `owner_team`) and camelCase where the payload builder names
+ * them itself. Mirrored from agentlens/explorer.py :: build_payload().
+ */
+
+export type Severity = 'breaks' | 'degrades' | 'unchanged';
+
+export type ChangeKind = 'drop-column' | 'rename-table' | 'drop-table';
+
+/** A node in the fleet graph. `kind` is 'agent', 'skill', 'tool' or 'table'. */
+export interface AgentLensNode {
+    kind?: string;
+    id?: string;
+    name?: string;
+    source_path?: string;
+    owner_team?: string;
+}
+
+export interface AgentLensTable {
+    /** The reference as written in the skill, before resolution. */
+    raw: string;
+    /** Skill ids that read this table. */
+    readers: string[];
+}
+
+export interface AgentLensPayload {
+    /** urn -> downstream urns. The lineage we emitted, as an adjacency list. */
+    index: Record<string, string[]>;
+    meta: Record<string, AgentLensNode>;
+    /** skill id -> the text of its SKILL.md. */
+    skillText: Record<string, string>;
+    /** agent id -> the skill ids it owns. */
+    agentSkills: Record<string, string[]>;
+    tables: Record<string, AgentLensTable>;
+    /** Column names seen across every skill, for the chips. */
+    columns: string[];
+    /** Table references we could not match to anything in the catalog. */
+    unresolved: string[];
+    counts: { agents: number; skills: number; tools: number };
+    repository?: string | null;
+}
+
+export interface Change {
+    table: string;
+    kind: ChangeKind;
+    column?: string;
+    newName?: string;
+}
+
+export interface Effect {
+    severity: Severity;
+    /** 'skill' or 'agent'. */
+    kind: string;
+    name: string;
+    id: string;
+    /** Hops downstream of the changed table. */
+    hops: number;
+    /** Why this verdict — shown verbatim, so it has to read as a sentence. */
+    why: string;
+    sourcePath: string;
+    ownerTeam: string;
+}
diff --git a/datahub-web-react/src/app/entityV2/dataset/profile/AgentImpact/useAgentLensPayload.ts b/datahub-web-react/src/app/entityV2/dataset/profile/AgentImpact/useAgentLensPayload.ts
