+
+export default function AgentImpactTab() {
+    const { urn } = useEntityData();
+    const { payload, loading, error } = useAgentLensPayload();
+
+    const [kind, setKind] = useState<ChangeKind>('drop-column');
+    const [column, setColumn] = useState('');
+    const [newName, setNewName] = useState('');
+
+    // The payload is keyed by the resolved dataset urn, so this is normally a
+    // direct hit. The substring fallback covers a urn that differs only by env
+    // or platform casing, which is otherwise an invisible empty tab.
+    const tableUrn = useMemo(() => {
+        if (!payload) return undefined;
+        if (payload.tables[urn]) return urn;
+        return Object.keys(payload.tables).find((candidate) => candidate.includes(shortName(urn)));
+    }, [payload, urn]);
+
+    const change = useMemo(() => ({ table: tableUrn || '', kind, column, newName }), [tableUrn, kind, column, newName]);
+
+    const needsColumn = kind === 'drop-column' && !column;
+    const effects = useMemo(
+        () => (payload && tableUrn && !needsColumn ? simulate(payload, change) : []),
+        [payload, tableUrn, needsColumn, change],
+    );
+
+    const count = (severity: Severity) => effects.filter((e) => e.severity === severity).length;
+
+    if (loading) {
+        return (
+            <Wrapper>
+                <Note>Loading the fleet…</Note>
+            </Wrapper>
+        );
+    }
+
+    if (error || !payload) {
+        return (
+            <Wrapper>
+                <Empty>
+                    Could not reach AgentLens at <Mono>{PAYLOAD_URL}</Mono> ({error}).
+                    <br />
+                    Start it with <Mono>agentlens serve</Mono> in your agent repo, then reload.
+                </Empty>
+            </Wrapper>
+        );
+    }
+
+    if (!tableUrn) {
