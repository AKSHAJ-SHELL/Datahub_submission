+                {readers.length === 1 ? 'skill' : 'skills'} read <Mono>{shortName(tableUrn)}</Mono>.
+            </Note>
+
+            <Controls>
+                <div>
+                    <Label>Simulate a change</Label>
+                    <Row>
+                        {KINDS.map((option) => (
