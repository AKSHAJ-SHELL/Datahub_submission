+                    across {payload.counts.agents} agents and {payload.counts.skills} skills
+                    {payload.repository ? ` in ${payload.repository}` : ''}.
+                </Empty>
+            </Wrapper>
+        );
+    }
+
+    const readers = payload.tables[tableUrn]?.readers ?? [];
+    const downstream = effects.length;
+    const flagged = count('breaks') + count('degrades');
+    const spared = downstream - flagged;
+
+    return (
