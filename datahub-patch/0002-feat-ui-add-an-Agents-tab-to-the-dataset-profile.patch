new file mode 100644
index 0000000000..19a8b5090e
--- /dev/null
+++ b/datahub-web-react/src/app/entityV2/dataset/profile/AgentImpact/simulate.ts
@@ -0,0 +1,129 @@
+import { AgentLensPayload, Change, Effect, Severity } from '@app/entityV2/dataset/profile/AgentImpact/types';
+
+/**
+ * Mirrors agentlens/sandbox.py :: simulate(). Keep the two in step.
+ *
+ * The point of running it here rather than calling the CLI is that the answer
+ * arrives as fast as you can click. The CLI stays authoritative — this is the
+ * same algorithm over the same data, but if the two ever disagree, the CLI is
+ * the one that gets committed to CI.
+ */
+
+const MAX_HOPS = 6;
+
+/**
+ * Word-boundary, case-insensitive: `discount_pct` matches `o.discount_pct` and
+ * `SUM(discount_pct)` but not `discount_pct_v2`.
+ */
+export function mentions(text: string, column: string): boolean {
+    if (!text || !column) return false;
+    const escaped = column.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+    return new RegExp(`\\b${escaped}\\b`, 'i').test(text);
+}
+
+/** Everything downstream of `from`, mapped to the hop count it was reached at. */
+function reach(index: Record<string, string[]>, from: string): Map<string, number> {
+    const reached = new Map<string, number>();
+    let frontier = [from];
+    const seen = new Set(frontier);
+    for (let hop = 1; hop <= MAX_HOPS; hop++) {
+        const next: string[] = [];
+        frontier.forEach((urn) => {
+            (index[urn] || []).forEach((child) => {
+                if (!seen.has(child)) {
+                    seen.add(child);
+                    reached.set(child, hop);
+                    next.push(child);
+                }
+            });
+        });
+        frontier = next;
+        if (!frontier.length) break;
+    }
+    return reached;
+}
+
+const RANK: Record<Severity, number> = { breaks: 0, degrades: 1, unchanged: 2 };
+
+export function simulate(payload: AgentLensPayload, change: Change): Effect[] {
+    const reached = reach(payload.index, change.table);
+    const effects: Effect[] = [];
+    const broken = new Set<string>();
+
+    // Skills first: an agent's verdict depends on which of its skills broke.
+    reached.forEach((hops, urn) => {
+        const node = payload.meta[urn] || {};
+        if (node.kind !== 'skill') return;
+        const text = payload.skillText[node.id || ''] || '';
+        let severity: Severity;
+        let why: string;
+        if (change.kind === 'drop-column') {
+            const column = change.column || '';
+            if (!text) {
+                severity = 'breaks';
+                why = 'could not read the skill file - assuming affected';
+            } else if (mentions(text, column)) {
+                severity = 'breaks';
+                why = `names ${column} in its text`;
+            } else {
+                severity = 'unchanged';
+                why = `reads the table but never names ${column}`;
+            }
+        } else if (change.kind === 'rename-table') {
+            severity = 'breaks';
+            why = `names the old table; text must change to ${change.newName || 'the new name'}`;
+        } else {
+            severity = 'breaks';
+            why = 'the table it reads would not exist';
+        }
+        if (severity === 'breaks' && node.id) broken.add(node.id);
+        effects.push({
+            severity,
+            kind: 'skill',
+            name: node.name || node.id || urn,
+            id: node.id || urn,
+            hops,
+            why,
+            sourcePath: node.source_path || '',
+            ownerTeam: '',
+        });
+    });
+
+    reached.forEach((hops, urn) => {
+        const node = payload.meta[urn] || {};
+        if (node.kind !== 'agent') return;
+        const via = (payload.agentSkills[node.id || ''] || []).filter((s) => broken.has(s)).sort();
+        effects.push({
+            severity: via.length ? 'degrades' : 'unchanged',
+            kind: 'agent',
+            name: node.name || node.id || urn,
+            id: node.id || urn,
+            hops,
+            why: via.length ? `via ${via.join(', ')}` : 'none of its skills name the change',
+            sourcePath: node.source_path || '',
+            ownerTeam: node.owner_team || '',
+        });
+    });
+
+    effects.sort(
+        (a, b) => RANK[a.severity] - RANK[b.severity] || a.kind.localeCompare(b.kind) || a.name.localeCompare(b.name),
+    );
+    return effects;
+}
+
+/** `urn:li:dataset:(urn:li:dataPlatform:snowflake,analytics.orders,PROD)` -> `analytics.orders` */
+export function shortName(urn: string): string {
+    return urn && urn.includes(',') ? urn.split(',')[1] : urn;
+}
+
+/** The command that reproduces what the tab is showing. */
+export function cliCommand(change: Change): string {
+    const flag =
+        // eslint-disable-next-line no-nested-ternary
+        change.kind === 'drop-column'
+            ? `--drop-column ${change.column || '<column>'}`
+            : change.kind === 'rename-table'
+              ? `--rename-to ${change.newName || '<name>'}`
+              : '--drop-table';
+    return `agentlens sandbox ${shortName(change.table)} ${flag}`;
+}
