@@ -0,0 +1,58 @@
+import { useEffect, useState } from 'react';
+
+import { AgentLensPayload } from '@app/entityV2/dataset/profile/AgentImpact/types';
+
+/**
+ * The tag `agentlens guard` writes onto tables the fleet reads. It is what
+ * makes the Agents tab appear on exactly those tables and nowhere else.
+ */
+export const AGENT_CONSUMERS_TAG_URN = 'urn:li:tag:has-agent-consumers';
+
+/**
+ * Same-origin in dev via the vite proxy, and in a real deployment via whatever
+ * fronts the app. `agentlens serve` is the thing on the other end.
+ */
+export const PAYLOAD_URL = '/agentlens/payload.json';
+
+export interface PayloadState {
+    payload?: AgentLensPayload;
+    loading: boolean;
+    /** Set when we could not load — rendered as guidance, not a stack trace. */
+    error?: string;
+}
+
+export function useAgentLensPayload(): PayloadState {
+    const [state, setState] = useState<PayloadState>({ loading: true });
+
+    useEffect(() => {
+        let live = true;
+        const controller = new AbortController();
+
+        fetch(PAYLOAD_URL, { signal: controller.signal })
+            .then(async (response) => {
+                if (!response.ok) throw new Error(`${response.status} ${response.statusText}`);
+                return response.json();
+            })
+            .then((payload: AgentLensPayload) => {
+                if (!live) return;
+                // A payload without an index would silently simulate to "nothing
+                // downstream", which reads as "safe to change". Refuse instead.
+                if (!payload?.index || !payload?.meta) {
+                    setState({ loading: false, error: 'The payload is missing its fleet graph.' });
+                    return;
+                }
+                setState({ loading: false, payload });
+            })
+            .catch((err: Error) => {
+                if (!live || err.name === 'AbortError') return;
+                setState({ loading: false, error: err.message });
+            });
+
+        return () => {
+            live = false;
+            controller.abort();
+        };
+    }, []);
+
+    return state;
+}
