+import { AGENT_CONSUMERS_TAG_URN } from '@app/entityV2/dataset/profile/AgentImpact/useAgentLensPayload';
+
+import { GetDatasetQuery } from '@graphql/dataset.generated';
+
+/**
+ * Whether `agentlens guard` has tagged this table as read by the agent fleet.
+ *
+ * The tag rides in on `globalTags`, which the dataset query already fetches, so
+ * gating the tab on it costs no extra request — and means the tab shows up on
+ * exactly the tables agents actually read rather than on all of them.
+ */
+export function hasAgentConsumers(dataset?: GetDatasetQuery): boolean {
+    return !!dataset?.dataset?.globalTags?.tags?.some(
+        (association) => association?.tag?.urn === AGENT_CONSUMERS_TAG_URN,
+    );
+}
